{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/buyer-resources.html",
      "destination": "/engineering-resources.html",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/engineering-resources.html",
      "permanent": true
    },
    {
      "source": "/engineering-resources",
      "destination": "/engineering-resources.html",
      "permanent": true
    },
    {
      "source": "/request-a-quote",
      "destination": "/request-a-quote.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "longrichpower.com"
        }
      ],
      "destination": "https://www.longrichpower.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
